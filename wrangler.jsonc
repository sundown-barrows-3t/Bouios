{
  // Customer template. The Deploy to Cloudflare button provisions the D1
  // database on the customer's account, fills in database_id, prompts for
  // the BEARER_TOKEN secret (declared under "secrets" below, so the deploy
  // asks for it), then deploys. No storage bucket is declared here:
  // transcript storage is a second step (worker/hooks/add-transcript-storage.sh).
  "name": "memory-vault",
  "main": "src/index.js",
  "compatibility_date": "2026-06-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "memory-vault",
      "database_id": "PLACEHOLDER_PROVISIONED_ON_DEPLOY"
    }
  ],
  "vars": {
    "GATEWAY_URL": "https://memory-gateway.bouios.com"
  },
  "secrets": {
    "required": ["BEARER_TOKEN"]
  }
}
