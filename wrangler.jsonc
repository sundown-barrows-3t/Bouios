{
  // Customer template for the Deploy to Cloudflare button.
  // The button clones this to the customer's own GitHub, provisions the D1
  // database below on THEIR account and binds it, prompts for the BEARER_TOKEN
  // secret, then deploys. database_id is a placeholder the deploy flow fills in.
  "name": "memory-vault",
  "main": "src/index.js",
  "compatibility_date": "2026-06-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "memory-vault",
      "database_id": "PLACEHOLDER_PROVISIONED_ON_DEPLOY"
    }
  ],
  "vars": {
    "AUTH_MODE": "bearer",
    "GATEWAY_URL": "https://memory-gateway.syndakat.com"
  },
  // Declares BEARER_TOKEN as a required secret so the Deploy to Cloudflare
  // button actually prompts for it and wrangler refuses to deploy without it
  // (Cloudflare secrets.required property, shipped 2026-03-25). Without this,
  // customer Workers deployed with BEARER_TOKEN unset and every /mcp/:token
  // call 401'd - the button never had anything to attach the package.json
  // description to.
  "secrets": {
    "required": ["BEARER_TOKEN"]
  }
}
